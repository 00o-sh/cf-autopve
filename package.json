{
  "name": "cf-autopve",
  "version": "1.0.0",
  "private": true,
  "description": "Proxmox VE automated-installation answer file configurator on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --host localhost",
    "deploy": "npm run db:migrate && wrangler deploy",
    "deploy:preview": "npm run db:migrate:preview && wrangler preview",
    "db:migrate": "wrangler d1 migrations apply autopve --remote",
    "db:migrate:preview": "wrangler d1 migrations apply autopve --remote --preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/logic.test.js test/worker.test.js",
    "db:init:local": "wrangler d1 migrations apply autopve --local",
    "pretest": "esbuild test/_bundle.ts --bundle --format=esm --platform=neutral --outfile=.test-build/bundle.mjs --log-level=warning && esbuild src/index.ts --bundle --format=esm --platform=neutral --outfile=.test-build/worker.mjs --log-level=warning",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261007.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "typescript": "7.0.2",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "smol-toml": "1.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.4"
}
